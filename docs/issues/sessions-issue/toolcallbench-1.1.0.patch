+def _open_store(args: argparse.Namespace) -> tuple[Store | None, Path]:
+    _, _, _, results_dir = _paths(args)
+    db = results_dir / "results.sqlite"
+    if not db.exists():
+        print(f"no results database at {db}; run a benchmark first", file=sys.stderr)
